# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

# Session secret — replace with a long random string in production
SESSION_SECRET=please-change-me-to-a-long-random-string

NODE_ENV=development
PORT=3000

# Set to 1 (or a hop count) ONLY when running behind a reverse proxy
# (Caddy/nginx). Leave unset for direct LAN so X-Forwarded-For cannot be
# spoofed to bypass the login rate limiter.
# TRUST_PROXY=1

# docker-compose postgres credentials
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
